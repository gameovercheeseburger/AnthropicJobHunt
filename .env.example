# Copy to .env (root) and apps/web/.env.local is not needed — the web app loads ../../.env.
# Never commit real secrets.

DATABASE_URL=postgres://ajh:ajh_local_dev@localhost:5433/ajh

# 32-byte base64 key for field-level encryption of resume data.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# S3-compatible storage (SeaweedFS locally)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ajh-resumes
S3_ACCESS_KEY_ID=ajh
S3_SECRET_ACCESS_KEY=ajh_local_dev

# Auth.js (step: auth & profile)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=AnthropicJobHunt <no-reply@localhost>

# AI (step: resume parsing / tailoring)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Job sources (step: connectors)
# Optional extra sources (not wired yet)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Production only: protects /api/cron/ingest (Vercel sends it automatically).
CRON_SECRET=
# Production only: Super Admin sign-in for the private beta. Leave empty locally.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JSearch (Google for Jobs: LinkedIn, Indeed, Job Bank, ...). RapidAPI → JSearch → subscribe → copy X-RapidAPI-Key.
JSEARCH_API_KEY=

# Hard cap on stored files in GB (Cloudflare R2). Uploads are refused rather than exceed it.
STORAGE_LIMIT_GB=8
