{
  "name": "anthropic-job-hunt",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @ajh/web",
    "build": "npm run build -w @ajh/web",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:generate": "npm run generate -w @ajh/db",
    "db:migrate": "npm run migrate -w @ajh/db",
    "db:seed": "npm run seed -w @ajh/db",
    "db:studio": "npm run studio -w @ajh/db",
    "setup": "npm run services:up && npm run db:migrate && npm run db:seed",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "resume:upload": "npm run resume:upload -w @ajh/app --"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
